# Copy to .env and fill in. .env is gitignored; never commit tokens.

# STF REST API (cloudf.one, or your own STF instance)
STF_API=https://cloudf.one/api/v1
STF_TOKEN=
DEVICE_SERIAL=

# Where adb reaches the phone. On cloudf.one via the WireGuard tunnel: 10.77.0.1.
# ADB_PORT is printed by scripts/lock_device.sh; set it by hand for any other phone.
ADB_HOST=10.77.0.1
ADB_PORT=

# Optional
APK_PATH=
APP_PACKAGE=
OUT_DIR=artifacts
